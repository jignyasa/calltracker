    <!-- Why this approach? -->
    <string name="about_detection_title">Automatic detection</string>
    <string name="about_detection_text">Every finished call is read from the phone\'s call log, the most reliable record on Android, even if the app was closed or the phone restarted.</string>
    <string name="about_privacy_title">Privacy first</string>
    <string name="about_privacy_text">Personal calls are never uploaded. Only calls marked Professional reach the CRM, and the database on the phone is encrypted.</string>
    <string name="about_matching_title">Smart matching</string>
    <string name="about_matching_text">Numbers are matched with existing leads and contacts in the CRM, or a new lead is created in one tap.</string>
    <string name="about_sync_title">Reliable sync</string>
    <string name="about_sync_text">Works offline and uploads with retries, duplicate prevention and conflict handling, so no call or note is lost or sent twice.</string>
    <string name="about_real_world_title">Built for the real world</string>
    <string name="about_real_world_text">Designed for low-end phones, poor networks, dual SIM and aggressive battery savers.</string>

