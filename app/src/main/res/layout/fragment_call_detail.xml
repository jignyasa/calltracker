<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header: who, and the call itself -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/avatar"
                            layout="@layout/view_avatar"
                            android:layout_width="56dp"
                            android:layout_height="56dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textIsSelectable="true"
                                android:textStyle="bold"
                                tools:text="Rahul Patel" />

                            <TextView
                                android:id="@+id/who"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="Lead · ABC Traders" />

                            <TextView
                                android:id="@+id/number"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textIsSelectable="true"
                                tools:text="+91 98765 43210" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/classificationPill"
                            style="@style/Widget.CallTracker.Pill"
                            android:layout_marginStart="8dp"
                            tools:backgroundTint="@color/pill_professional_bg"
                            tools:text="Professional"
                            tools:textColor="@color/pill_professional_fg" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="12dp"
                        app:dividerColor="?attr/colorOutlineVariant" />

                    <!-- Type · when · how long (· SIM) -->
                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="16dp"
                        app:chipSpacingVertical="4dp">

                        <TextView
                            android:id="@+id/metaType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="Outgoing" />

                        <TextView
                            android:id="@+id/metaDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            app:drawableStartCompat="@drawable/ic_event"
                            app:drawableTint="?attr/colorOnSurfaceVariant"
                            tools:text="Today, 10:24 AM" />

                        <TextView
                            android:id="@+id/metaDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            app:drawableStartCompat="@drawable/ic_schedule"
                            app:drawableTint="?attr/colorOnSurfaceVariant"
                            tools:text="4m 32s" />

                        <TextView
                            android:id="@+id/metaSim"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_sim"
                            app:drawableTint="?attr/colorOnSurfaceVariant"
                            tools:text="SIM 2"
                            tools:visibility="visible" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CRM record: the match, or the offer to create a lead -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/detail_associated_with"
                android:textAppearance="@style/TextAppearance.CallTracker.FieldLabel" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/crmCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <include
                        android:id="@+id/crmAvatar"
                        layout="@layout/view_avatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/crmName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold"
                            tools:text="Rahul Patel" />

                        <TextView
                            android:id="@+id/crm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Lead · ABC Traders" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/pill_ok_fg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/noCrmCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/noCrmText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_no_crm_match"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <Button
                        android:id="@+id/createLeadButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/detail_create_lead"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Professional or personal -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/detail_classification_header"
                android:textAppearance="@style/TextAppearance.CallTracker.FieldLabel" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/classificationToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="false"
                app:singleSelection="true">

                <Button
                    android:id="@+id/businessButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/classification_business"
                    app:icon="@drawable/ic_work" />

                <Button
                    android:id="@+id/personalButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/classification_personal"
                    app:icon="@drawable/ic_person" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="In CRM" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/applyToNumber"
                android:checked="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_apply_to_number" />

            <!-- Activity log -->
            <TextView
                android:id="@+id/logHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="?attr/colorSurfaceContainer"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:text="@string/detail_log_hint_not_business"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:drawableStartCompat="@drawable/ic_shield"
                app:drawableTint="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/logForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/detail_notes"
                    android:textAppearance="@style/TextAppearance.CallTracker.FieldLabel" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/notesLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:counterEnabled="true"
                    app:counterMaxLength="5000"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="@string/detail_notes_placeholder"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/detail_outcome"
                    android:textAppearance="@style/TextAppearance.CallTracker.FieldLabel" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/outcomeLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_check_circle"
                    app:startIconTint="@color/pill_ok_fg">

                    <AutoCompleteTextView
                        android:id="@+id/outcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        tools:ignore="LabelFor" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="@string/detail_follow_up"
                            android:textAppearance="@style/TextAppearance.CallTracker.FieldLabel" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/followUpLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:endIconContentDescription="@string/detail_follow_up_clear"
                            app:endIconDrawable="@drawable/ic_close"
                            app:endIconMode="custom"
                            app:hintEnabled="false"
                            app:startIconDrawable="@drawable/ic_event">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/followUp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:hint="@string/detail_follow_up_none"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="@string/detail_next_action"
                            android:textAppearance="@style/TextAppearance.CallTracker.FieldLabel" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/nextActionLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/nextAction"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/detail_next_action_placeholder"
                                android:inputType="textCapSentences" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/detail_remarks"
                    android:textAppearance="@style/TextAppearance.CallTracker.FieldLabel" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/remarksLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/remarks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/detail_remarks_placeholder"
                        android:inputType="textMultiLine|textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/syncStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:drawableStart="@drawable/ic_cloud_upload"
                    tools:text="Waiting to upload" />

                <Button
                    android:id="@+id/retryUploadButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/detail_retry_upload"
                    android:visibility="gone"
                    app:icon="@drawable/ic_sync" />

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/detail_save" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/notFound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:text="@string/detail_not_found"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone" />
</FrameLayout>
