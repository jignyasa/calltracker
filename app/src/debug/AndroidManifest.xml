<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: CallLogSeedReceiver inserts and removes fake CallLog rows for on-device testing. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Granted by hand: adb shell pm grant com.example.calltracker android.permission.WRITE_CALL_LOG -->
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />

    <application>
        <!-- DUMP is held by the adb shell but can't be granted to third-party apps, so only adb can trigger this. -->
        <receiver
            android:name=".debug.CallLogSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
